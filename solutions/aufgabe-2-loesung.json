{
  "id": "a2Loesung",
  "name": "Aufgabe 2: Agent (Lösung)",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "options": {}
      },
      "id": "g0",
      "name": "Chat",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "webhookId": "a2-chat"
    },
    {
      "parameters": {
        "promptType": "auto",
        "options": {
          "systemMessage": "Du bist der Assistent für Mitarbeitende. Antworte immer auf Deutsch, kurz und freundlich. Nutze die Tools, statt zu raten: suche Personen im Verzeichnis, prüfe freie Räume. Wenn ein Tool nichts findet, sag das offen."
        }
      },
      "id": "g1",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        300,
        0
      ]
    },
    {
      "parameters": {
        "model": "openai/gpt-4o-mini",
        "options": {}
      },
      "id": "g2",
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        100,
        260
      ],
      "credentials": {
        "openRouterApi": {
          "id": "or-workshop",
          "name": "OpenRouter (Workshop)"
        }
      }
    },
    {
      "parameters": {
        "contextWindowLength": 10
      },
      "id": "g3",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        300,
        260
      ]
    },
    {
      "parameters": {
        "description": "Sucht Mitarbeitende im Verzeichnis anhand des Namens (oder Namensteils). Liefert Abteilung, Rolle, E-Mail, Standort.",
        "workflowId": {
          "__rl": true,
          "value": "subMitarbeiter",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "name": "={{ $fromAI('name','Name oder Namensteil der gesuchten Person','string') }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "name",
              "displayName": "name",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      },
      "id": "g4",
      "name": "Mitarbeiter suchen",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2.2,
      "position": [
        500,
        260
      ]
    },
    {
      "parameters": {
        "endpointUrl": "http://tools:5678/mcp/workshop",
        "serverTransport": "httpStreamable",
        "authentication": "none",
        "include": "all",
        "options": {}
      },
      "id": "g5",
      "name": "MCP Client Tools-Server",
      "type": "@n8n/n8n-nodes-langchain.mcpClientTool",
      "typeVersion": 1.2,
      "position": [
        720,
        260
      ]
    }
  ],
  "connections": {
    "Chat": {
      "main": [
