# Diese Variablen kommen in Dokploy unter "Environment" des Compose-Services.
# NICHT ins Git-Repo committen (nur diese Beispieldatei).

# Basisdomain. Erreichbar: gtm1.DOMAIN ... gtm9.DOMAIN und tools.DOMAIN
# DNS: Wildcard *.DOMAIN auf die VPS-IP (oder 10 einzelne A-Records)
DOMAIN=rudimuc.de

# Gemeinsamer Schlüssel für Credentials:  openssl rand -hex 24
N8N_ENCRYPTION_KEY=

# Nach erfolgreichem Test auf eine feste Version pinnen
N8N_VERSION=latest
MEM_LIMIT=512m
TZ=Europe/Berlin

# Ein OpenRouter-Key pro Gruppe (bei OpenRouter mit Kreditlimit anlegen)
OPENROUTER_KEY_1=
OPENROUTER_KEY_2=
OPENROUTER_KEY_3=
OPENROUTER_KEY_4=
OPENROUTER_KEY_5=
OPENROUTER_KEY_6=
OPENROUTER_KEY_7=
OPENROUTER_KEY_8=
OPENROUTER_KEY_9=

# Passwörter der Owner-Accounts (Login: gtm1@workshop.example ... gtm9@workshop.example, tools@workshop.example)
# n8n verlangt: mind. 8 Zeichen, 1 Zahl, 1 Großbuchstabe, z. B. Wk-3fa9c1de-1
PW_GTM1=
PW_GTM2=
PW_GTM3=
PW_GTM4=
PW_GTM5=
PW_GTM6=
PW_GTM7=
PW_GTM8=
PW_GTM9=
PW_TOOLS=
